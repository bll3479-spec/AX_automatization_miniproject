# Claude API 키 (선택) - 규칙에 안 걸린 애매한 메일을 LLM으로 보조 분류할 때 사용
# 비워두면 규칙 기반 분류만 동작합니다.
ANTHROPIC_API_KEY=

# 규칙에 안 걸린 메일을 LLM으로 보조 분류할지 여부 (true/false)
USE_LLM_FALLBACK=true

# 보안(인증번호/로그인알림 등) 카테고리로 판정된 메일은 절대 LLM에 전달하지 않음 (true 권장)
SECURITY_LLM_BLOCK=true

# Gmail OAuth 자격증명/토큰 경로 (scripts/gmail_auth.py 로 생성)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
